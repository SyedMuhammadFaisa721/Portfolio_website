# Copy these values into the PythonAnywhere WSGI file as environment variables.
# Do not commit a real .env file.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
# Set to True only after confirming HTTPS is active for your domain.
DJANGO_SECURE_SSL_REDIRECT=False
